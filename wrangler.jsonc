{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appmem",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "50ca4675-de97-4b9e-911a-1eedd1bf4260","database_name": "web-appmem" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f73fee7268464a82846804cd08ad0038" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
